close all; clear all; clc

params.signal = 80;
params.sigmaPSF = 1.3;
params.background = 5;
params.QE = 0.95;
params.gain = 0.64;
params.readNoise = 1.0;
params.offset = 119;
params.bitDepth = 16;

imgSize = [100 100];

motionParams.D = 20;
motionParams.dt = 1e-3;
motionParams.pixelSize = 0.1625;
params.start = [0 0];

nFrames = 100;

rng(1)
pos = brownianMotion(nFrames, motionParams);
stack = zeros([imgSize, nFrames], 'uint16');

for t = 1:nFrames
    stack(:,:,t) = simulateParticleImage(pos(t,:), imgSize, params);
end


% Tracking in the stack
trackParams.sigmaPSF = 1.3; % known PSF
trackParams.filterSigma = 2;
trackParams.roiHalfWidth = 10;

[posTrack, fitInfo] = trackGaussianFit(stack, trackParams);

[D, out] = measureD(posTrack, struct('pixelSize',0.1625,'dt',1e-3));
%%
trailLen   = 40;          % frames of history to show (use nFrames for full track)
trailColor = [0 1 1];     % cyan  (use [1 0 0] for red)

[X,Y] = meshgrid(1:size(stack,2), 1:size(stack,1));
xc = X(1,:) - mean(X(1,:));
yc = Y(:,1) - mean(Y(:,1));

figure;
for t = 1:nFrames
    cla
    imagesc(xc, yc, stack(:,:,t)); axis image
    colormap gray; colorbar
    hold on

    % --- fading trail of past positions ---
    i0  = max(1, t - trailLen);
    seg = i0:t;
    for k = 1:numel(seg)-1
        a = k / numel(seg) * 0.7;                  % 0 = oldest, 1 = newest
        h = plot(posTrack(seg(k:k+1),1), posTrack(seg(k:k+1),2), '-');
        h.Color     = [trailColor, a];       % RGBA -- alpha fades the tail
        h.LineWidth  = 0.5 + 2.5*a;          % thin tail -> thick head
    end

    % --- current position ---
    plot(posTrack(t,1), posTrack(t,2), 'x', ...
         'Color', trailColor, 'MarkerSize', 10, 'LineWidth', 1.5);

    drawnow
end

%% ML

% 1. make labelled data from your own simulator
[X, Y] = generateTrainingData(10000, struct('signalRange',[10 500]));
%%
% 2. train (minutes on a laptop; needs Deep Learning Toolbox)
net = trainParticleNet(X, Y);
%%
% 3. track a movie with it
posML = trackMLmatlab(stack, net, struct('patchHalf',7));

trailLen   = 40;          % frames of history to show (use nFrames for full track)
trailColor = [0 1 1];     % cyan  (use [1 0 0] for red)

[X,Y] = meshgrid(1:size(stack,2), 1:size(stack,1));
xc = X(1,:) - mean(X(1,:));
yc = Y(:,1) - mean(Y(:,1));

figure;
for t = 1:nFrames
    cla
    imagesc(xc, yc, stack(:,:,t)); axis image
    colormap gray; colorbar
    hold on

    % --- fading trail of past positions ---
    i0  = max(1, t - trailLen);
    seg = i0:t;
    for k = 1:numel(seg)-1
        a = k / numel(seg) * 0.7;                  % 0 = oldest, 1 = newest
        h = plot(posML(seg(k:k+1),1), posML(seg(k:k+1),2), '-');
        h.Color     = [trailColor, a];       % RGBA -- alpha fades the tail
        h.LineWidth  = 0.5 + 2.5*a;          % thin tail -> thick head
    end

    % --- current position ---
    plot(posML(t,1), posML(t,2), 'x', ...
         'Color', trailColor, 'MarkerSize', 10, 'LineWidth', 1.5);

    drawnow
end
%%
% 4. score it exactly like the classical arm
rmseML = sqrt(mean(sum((posML - posTrue).^2, 2)));